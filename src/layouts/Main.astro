---
interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
---

<main id="main-content" class="mx-auto w-full max-w-app px-6 py-8 flex-1">
  {
    "titleTransition" in props ? (
      <h1 class="text-2xl font-semibold mb-1">
        {props.pageTitle[0]}{" "}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="text-2xl font-semibold mb-1">{props.pageTitle}</h1>
    )
  }
  {props.pageDesc && <p class="text-sm text-muted mb-6">{props.pageDesc}</p>}
  <slot />
</main>
