---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SOCIALS } from "@/constants";
---

<Layout>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-app px-6 py-8 flex-1">
    <h1 class="sr-only">Matthew Li</h1>
    <p class="mb-4">
      I'm Matthew, a first-year undergraduate studying computer science at
      Carnegie Mellon University. I'm interested in deep learning and systems.
    </p>
    <div class="flex gap-4 text-muted">
      {
        SOCIALS.map(social => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline hover:text-foreground"
            title={social.linkTitle}
          >
            <social.icon class="size-6 stroke-current fill-none" />
            <span class="sr-only">{social.name}</span>
          </a>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
