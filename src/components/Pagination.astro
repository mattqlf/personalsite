---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mx-auto mb-8 flex w-full max-w-app items-center justify-center gap-4 px-6 text-sm text-muted"
      aria-label="Pagination"
    >
      {page.url.prev ? (
        <a href={page.url.prev} class="no-underline hover:text-foreground">
          &larr; prev
        </a>
      ) : (
        <span class="opacity-30">&larr; prev</span>
      )}
      <span>
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="no-underline hover:text-foreground">
          next &rarr;
        </a>
      ) : (
        <span class="opacity-30">next &rarr;</span>
      )}
    </nav>
  )
}
