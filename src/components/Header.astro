---
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
const isActive = (path: string) => currentPath.startsWith(path);
---

<header class="mx-auto w-full max-w-app px-6 pt-10 pb-2">
  <nav class="flex items-baseline justify-between">
    <span class="text-lg font-semibold">{SITE.title}</span>
    <div class="flex gap-5 text-sm text-muted">
      <a
        href="/"
        class:list={[
          "no-underline hover:text-foreground",
          { "text-foreground": currentPath === "/" },
        ]}>about</a
      >
      <a
        href="/posts"
        class:list={[
          "no-underline hover:text-foreground",
          { "text-foreground": isActive("/posts") },
        ]}>posts</a
      >
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="cursor-pointer text-muted hover:text-foreground"
            aria-label="Toggle theme"
          >
            <span class="dark:hidden">dark</span>
            <span class="hidden dark:inline">light</span>
          </button>
        )
      }
    </div>
  </nav>
</header>
