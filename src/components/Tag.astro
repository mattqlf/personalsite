---
import IconHash from "@/assets/icons/IconHash.svg";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li
  class="group inline-block group-hover:cursor-pointer"
  style={size === "sm" ? "margin: 4px 8px 4px 0;" : "margin: 12px 12px 12px 4px;"}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-block text-accent hover:text-foreground hover:underline no-underline",
      { "text-sm": size === "sm", "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "inline-block opacity-80",
        { "size-4": size === "sm" },
        { "size-6": size === "lg" },
      ]}
    /><span>{tagName}</span>
  </a>
</li>
