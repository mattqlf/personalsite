---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li class="inline-block mr-3 mb-2">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "no-underline text-muted hover:text-foreground",
      { "text-sm": size === "sm", "text-base": size === "lg" },
    ]}
  >
    #{tagName}
  </a>
</li>
