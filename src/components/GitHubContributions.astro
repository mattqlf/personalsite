---
export interface Props {
  apiPath?: string;
}

const { apiPath = "/api/github" } = Astro.props;
---

<div
  id="github-contributions"
  data-api-path={apiPath}
  class="w-full max-w-3xl"
>
  <div class="mb-3 text-sm text-foreground/80 font-medium">
    <span data-total>Loading contributions...</span>
  </div>
  <div class="overflow-x-auto">
    <div class="inline-block min-w-fit">
      <div data-months class="mb-[2px] flex text-[11px] text-foreground/50">
      </div>
      <div data-grid class="flex gap-[3px]">
      </div>
    </div>
  </div>
  <div class="mt-2 flex items-center justify-end gap-[6px] text-[11px] text-foreground/50">
    <span>Less</span>
    <div class="flex gap-[3px]" data-legend>
      <div class="size-[10px] rounded-[2px] bg-[#ebedf0] dark:bg-[#161b22] outline outline-1 outline-black/5 dark:outline-white/5"></div>
      <div class="size-[10px] rounded-[2px] bg-[#9be9a8] dark:bg-[#0e4429]"></div>
      <div class="size-[10px] rounded-[2px] bg-[#40c463] dark:bg-[#006d32]"></div>
      <div class="size-[10px] rounded-[2px] bg-[#30a14e] dark:bg-[#26a641]"></div>
      <div class="size-[10px] rounded-[2px] bg-[#216e39] dark:bg-[#39d353]"></div>
    </div>
    <span>More</span>
  </div>
</div>

<script is:inline data-astro-rerun>
  const initGitHubContributions = () => {
    const root = document.querySelector("#github-contributions");
    if (!root) return;

    const apiPath = root.getAttribute("data-api-path") || "/api/github";
    const totalEl = root.querySelector("[data-total]");
    const gridEl = root.querySelector("[data-grid]");
    const monthsEl = root.querySelector("[data-months]");

    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    const renderGrid = (weeks) => {
      if (!gridEl || !monthsEl) return;

      gridEl.innerHTML = "";
      monthsEl.innerHTML = "";

      let lastMonth = -1;
      const monthPositions = [];

      weeks.forEach((week, weekIndex) => {
        const weekCol = document.createElement("div");
        weekCol.className = "flex flex-col gap-[3px]";

        week.contributionDays.forEach((day, dayIndex) => {
          const square = document.createElement("div");
          square.style.width = "10px";
          square.style.height = "10px";
          square.style.borderRadius = "2px";
          square.style.backgroundColor = day.color;
          if (day.contributionCount === 0) {
            square.style.outline = "1px solid rgba(0,0,0,0.06)";
          }
          square.title = `${day.contributionCount} contribution${day.contributionCount !== 1 ? 's' : ''} on ${day.date}`;
          weekCol.appendChild(square);

          if (dayIndex === 0) {
            const date = new Date(day.date);
            const month = date.getMonth();
            if (month !== lastMonth) {
              monthPositions.push({ month, weekIndex });
              lastMonth = month;
            }
          }
        });

        gridEl.appendChild(weekCol);
      });

      const totalWidth = weeks.length * 13;
      monthsEl.style.width = `${totalWidth}px`;
      monthsEl.style.position = "relative";

      monthPositions.forEach(({ month, weekIndex }) => {
        const label = document.createElement("span");
        label.textContent = MONTHS[month];
        label.style.position = "absolute";
        label.style.left = `${weekIndex * 13}px`;
        monthsEl.appendChild(label);
      });
    };

    const fetchContributions = async () => {
      try {
        const response = await fetch(apiPath, {
          headers: { Accept: "application/json" },
        });

        if (!response.ok) {
          if (totalEl) totalEl.textContent = "Failed to load contributions";
          return;
        }

        const data = await response.json();

        if (data.error) {
          if (totalEl) totalEl.textContent = "Failed to load contributions";
          return;
        }

        if (totalEl) {
          totalEl.textContent = `${data.totalContributions.toLocaleString()} contributions in the last year`;
        }

        renderGrid(data.weeks);
      } catch (error) {
        if (totalEl) totalEl.textContent = "Failed to load contributions";
      }
    };

    fetchContributions();
  };

  initGitHubContributions();
</script>
